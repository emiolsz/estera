# Vercel > Settings > Environment Variables. Nie wpisuj prawdziwych kluczy do GitHuba.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAIL=
# AI oraz wysyłka PDF są opcjonalne; bez nich działa strona i lokalne pobieranie PDF.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
RESEND_API_KEY=
MAIL_FROM=

# Google Gemini (pierwszeństwo, jeśli podano oba klucze AI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Brevo — można wykorzystać istniejące konto zamiast Resend.
BREVO_API_KEY=
# Opcjonalny jawny wybór: google / openai oraz brevo / resend.
AI_PROVIDER=
MAIL_PROVIDER=
